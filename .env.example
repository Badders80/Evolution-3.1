# Public API mode and endpoint
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=https://your-api-url.com

# Sanity CMS (optional if not using Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2023-10-04
SANITY_READ_TOKEN=your-sanity-read-token

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Interest capture webhook (optional; falls back to in-code default)
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/your-script-id/exec

# SSOT repository seam
SSOT_DATA_SOURCE=local
SSOT_HLT_DATA_SOURCE=local
# SSOT_SEED_PATH=../SSOT_Build/intake/v0.1/seed.json
# SSOT_HLT_DRAFTS_DIR=../SSOT_Build/intake/v0.1/hlt_drafts

# Build analysis toggle (optional)
ANALYZE=false
