# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Lead capture / sign-in tracking
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/your-web-app-id/exec
MARKETPLACE_MANUAL_OPS_PATH=/absolute/path/to/marketplace-manual-ops.json
NEXT_PUBLIC_MARKETPLACE_RELEASE_STAGE=live

# Optional demo API layer
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=https://api.example.com

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_real_key
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret

# Resend (transactional email)
RESEND_API_KEY=re_replace_with_real_key

# Sumsub (KYC — placeholder only)
NEXT_PUBLIC_SUMSUB_APP_TOKEN=replace_with_sumsub_app_token
SUMSUB_API_KEY=replace_with_sumsub_api_key
SUMSUB_SECRET_KEY=replace_with_sumsub_secret_key

# MyStable release stage
NEXT_PUBLIC_MYSTABLE_RELEASE_STAGE=working_on

# Admin authentication
ADMIN_SECRET_KEY=replace-with-a-long-random-admin-secret
